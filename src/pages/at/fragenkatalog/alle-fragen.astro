---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import ButtonLink from '../../../components/ButtonLink.astro';
import { getQuestions } from '../../../lib/questions';

const questions = await getQuestions();
---

<BaseLayout title="Alle Fragen für den Führerschein in Österreich!">
  <Section class="container mx-auto" padding="px-10 md:px-20 lg:px-40 pt-10 pb-20">
    {import.meta.env.DEV && questions.length === 0 && (
      <p class="text-center text-gray-500">
        Keine Fragen geladen: <code>FONLINE_API_KEY</code> ist nicht gesetzt (siehe README). Dieser Hinweis erscheint
        nur im Dev-Server.
      </p>
    )}
    <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
      {questions.map((question) => (
        <ButtonLink href={`/at/fragenkatalog/frage/${question.qst_id}/`}>
          <div class="flex items-center">{`Frage ${question.qst_id}`}</div>
        </ButtonLink>
      ))}
    </div>
  </Section>
</BaseLayout>
