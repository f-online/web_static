---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import DrivingSchool from '../../../components/DrivingSchool.astro';
import { getDrivingSchoolsByRegion } from '../../../lib/drivingSchools';

const regions = await getDrivingSchoolsByRegion();
---

<BaseLayout title="Fahrschulen">
  <Section class="bg-fonline-50">
    <SectionHeader
      title="Fahrschulen"
      subtitle="Die folgenden Fahrschulen wollen nicht nur an euch verdienen, sondern empfehlen die kostenlose Lernplattform F-Online als Alternative. Vielen Dank. Lernen könnt ihr natürlich immer mit F-Online, egal bei welcher Fahrschule in Österreich ihr die Fahrprüfung macht."
    />

    <div>
      {regions.map((region) => (
        <div class="my-10">
          <h3 class="text-2xl text-center font-bold mb-2 text-gray-800">
            <a href={`/at/fahrschulen/${region.slug}/`} class="no-underline">
              {region.name}
            </a>
          </h3>
          <div class="w-10 h-0.5 bg-fonline-500 mx-auto mb-3" />
          <h4 class="text-center text-gray-500 max-w-md mx-auto mb-5">
            {`${region.schools.length} Fahrschulen in ${region.name} empfehlen F-Online`}
          </h4>
          <div class="flex flex-row flex-wrap justify-center items-center">
            {region.schools.map((school) => (
              <div class="w-full sm:w-1/2 lg:w-1/3 xl:w-1/4">
                <DrivingSchool school={school} class="m-6 bg-white" />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Section>
</BaseLayout>
